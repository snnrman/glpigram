# --- Telegram ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Chat id of the technician Telegram group. Required for account linking:
# linking requests are confirmed with a button there (membership = trust boundary).
TECH_GROUP_CHAT_ID=-1001234567890

# --- GLPI legacy REST API (v1) ---
# Base URL of apirest.php on the local vhost.
GLPI_API_URL=http://127.0.0.1/apirest.php
# App-Token from Setup > General > API. Optional: the localhost API client
# does not require one, so leave empty unless GLPI enforces App-Tokens.
GLPI_APP_TOKEN=
# user_token of the dedicated service account (Preferences > API tokens).
GLPI_USER_TOKEN=your-service-account-user-token
# HTTP timeout for GLPI calls, seconds.
GLPI_TIMEOUT=20

# --- Account linking / technician rights ---
# GLPI group id whose members are technicians (is_tech). Leave empty => nobody is tech.
TECH_GROUP_ID=
# Seconds between GLPI re-checks of a linked account (still active + is_tech).
LINK_RECHECK_TTL=300

# --- Sync loop ---
# GLPI polling interval in seconds (new tickets, status changes, followups).
SYNC_INTERVAL=45

# --- Requester "remind" button ---
# Minimum hours between a requester's reminders about the same ticket.
REMIND_COOLDOWN_HOURS=4
# Requester nudges to confirm a proposed solution, in WORKING minutes. 0 disables.
SOLUTION_REMIND_MINUTES=30

# --- Unassigned-tickets reminder (tech group) ---
# Remind about New (unassigned) tickets older than this many WORKING hours.
UNASSIGNED_REMIND_HOURS=2
# Min WORKING hours between repeated reminders about the same ticket.
REMIND_INTERVAL_HOURS=3

# --- Quiet hours (off-hours) ---
# Bot timezone (used for quiet hours, "created X ago", etc). Also sets the
# process TZ so GLPI's UTC dates render locally. e.g. Europe/Kaliningrad.
TZ=Europe/Kaliningrad
# Working hours and days (ISO weekdays Mon=1..Sun=7).
WORK_HOURS=09:00-18:00
WORK_DAYS=1-5
# Off-hours, ordinary tickets (low/medium/high) are queued until the next work
# day. Only the dedicated "🔴 Срочно (прод)" level from the /new dialog breaks
# through and pings the tech group immediately — there is no urgency-threshold
# knob (the breakthrough is tied to that product-level choice, not a number).

# --- Behaviour ---
# Bot language for all user-facing strings: ru | en (default ru).
BOT_LANGUAGE=ru
# Optional custom /start greeting for LINKED users, shown verbatim in both
# languages (no translation; unlinked users always get the sign-in prompt).
# aiogram HTML markup is allowed; use \n for line breaks.
# WELCOME_MESSAGE=Привет! Это <b>бот поддержки ACME</b>.\nОпишите проблему — мы поможем.
# ITILCategory cache lifetime, seconds (default 10 min).
CATEGORY_CACHE_TTL=600
# SQLite database path (writable by the glpibot user).
DB_PATH=/var/lib/glpi-tgbot/glpi-tgbot.sqlite3
LOG_LEVEL=INFO

# --- Optional outbound proxy (standard variable, honoured by httpx + aiogram) ---
# HTTPS_PROXY=http://proxy.internal:3128

# --- Lead access approval (feature: access requests) ---
# AD logins of the leads who approve access requests (comma-separated).
# The «🔑 Доступ» dialog offers only leads that are linked to the bot.
LEAD_LOGINS=ivan.petrov,anna.sidorova
# ITILCategory id for access tickets (e.g. «Учётки и доступы»).
ACCESS_CATEGORY_ID=
# Re-ping a silent lead about a pending approval every N WORKING hours.
APPROVAL_REMIND_HOURS=4

# Claude alone needs an additional approval from one of these GLPI users.
# Empty or unavailable approvers BLOCK new Claude requests, not bypass approval.
# Users must be active and linked to the bot; ids are snapshotted per request.
CLAUDE_APPROVER_GLPI_IDS=

# Optional AI observation. Does NOT route tickets, hide buttons, or approve access.
# Only newly submitted bot tickets; no historical backfill or attachment processing.
AI_SHADOW_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini-2025-08-07
# Total deadline, no automatic retries. Max 6000 input chars and 512 output tokens.
AI_SHADOW_TIMEOUT=15
# Requests per UTC day, including failed/interrupted requests. Excess jobs are skipped.
AI_SHADOW_DAILY_LIMIT=100
# Existing internal deployments exempt from SaaS access approval (comma-separated).
# This does not exempt purchases of external Cloud editions/new licences.
AI_INTERNAL_SERVICES=

# New single-description intake, automatic title/category, technician review.
# OFF by default. Configure new GLPI category IDs before enabling; never reuse
# historical categories by renaming them. No GLPI category creation is automatic.
AI_INTAKE_ENABLED=false
# Optional pilot: authenticated Telegram sender IDs, never usernames or GLPI IDs.
# With ENABLED=true, [] enables the new form for EVERY linked user.
# Set the pilot list before enabling, e.g. AI_INTAKE_PILOT_TG_IDS=[990948].
AI_INTAKE_PILOT_TG_IDS=[]
# Optional exact allowlist for the old form (also hides a new taxonomy's parent).
# Reserved AI_INTAKE_CATEGORY_IDS are always excluded from the old form.
# On rollback, keep the pilot and category ID settings; disable only ENABLED.
# Existing review buttons and recovery must keep working for submitted tickets.
AI_INTAKE_LEGACY_CATEGORY_IDS=[]
# Blank inherits OPENAI_MODEL; independent override does not alter shadow mode.
AI_INTAKE_MODEL=
AI_INTAKE_TIMEOUT=15
# Persisted UTC-day budget; failed/time-out requests count, no automatic retries.
AI_INTAKE_DAILY_LIMIT=100
# Longer requests keep their full original text and use a marked fallback, not truncation.
AI_INTAKE_MAX_INPUT_CHARS=6000
# Set all keys to DISTINCT positive IDs from your GLPI; example IDs are placeholders.
# AI_INTAKE_CATEGORY_IDS={"accounts":101,"network":102,"hardware":103,"software":104,"infrastructure":105,"purchases":106,"other":107}
AI_INTAKE_CATEGORY_IDS={}
