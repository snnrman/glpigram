# --- Telegram ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Chat id of the technician Telegram group. Required for account linking:
# linking requests are confirmed with a button there (membership = trust boundary).
TECH_GROUP_CHAT_ID=-1001234567890

# --- GLPI legacy REST API (v1) ---
# Base URL of apirest.php on the local vhost.
GLPI_API_URL=http://127.0.0.1/apirest.php
# App-Token from Setup > General > API. Optional: the localhost API client
# does not require one, so leave empty unless GLPI enforces App-Tokens.
GLPI_APP_TOKEN=
# user_token of the dedicated service account (Preferences > API tokens).
GLPI_USER_TOKEN=your-service-account-user-token
# HTTP timeout for GLPI calls, seconds.
GLPI_TIMEOUT=20

# --- Account linking / technician rights ---
# GLPI group id whose members are technicians (is_tech). Leave empty => nobody is tech.
TECH_GROUP_ID=
# Seconds between GLPI re-checks of a linked account (still active + is_tech).
LINK_RECHECK_TTL=300

# --- Sync loop ---
# GLPI polling interval in seconds (new tickets, status changes, followups).
SYNC_INTERVAL=45

# --- Requester "remind" button ---
# Minimum hours between a requester's reminders about the same ticket.
REMIND_COOLDOWN_HOURS=4

# --- Unassigned-tickets reminder (tech group) ---
# Remind about New (unassigned) tickets older than this many WORKING hours.
UNASSIGNED_REMIND_HOURS=2
# Min WORKING hours between repeated reminders about the same ticket.
REMIND_INTERVAL_HOURS=3

# --- Quiet hours (off-hours) ---
# Bot timezone (used for quiet hours, "created X ago", etc). Also sets the
# process TZ so GLPI's UTC dates render locally. e.g. Europe/Kaliningrad.
TZ=Europe/Kaliningrad
# Working hours and days (ISO weekdays Mon=1..Sun=7).
WORK_HOURS=09:00-18:00
WORK_DAYS=1-5
# Off-hours, ordinary tickets (low/medium/high) are queued until the next work
# day. Only the dedicated "🔴 Срочно (прод)" level from the /new dialog breaks
# through and pings the tech group immediately — there is no urgency-threshold
# knob (the breakthrough is tied to that product-level choice, not a number).

# --- Behaviour ---
# Bot language for all user-facing strings: ru | en (default ru).
BOT_LANGUAGE=ru
# Optional custom /start greeting for LINKED users, shown verbatim in both
# languages (no translation; unlinked users always get the sign-in prompt).
# aiogram HTML markup is allowed; use \n for line breaks.
# WELCOME_MESSAGE=Привет! Это <b>бот поддержки ACME</b>.\nОпишите проблему — мы поможем.
# ITILCategory cache lifetime, seconds (default 10 min).
CATEGORY_CACHE_TTL=600
# SQLite database path (writable by the glpibot user).
DB_PATH=/var/lib/glpi-tgbot/glpi-tgbot.sqlite3
LOG_LEVEL=INFO

# --- Optional outbound proxy (standard variable, honoured by httpx + aiogram) ---
# HTTPS_PROXY=http://proxy.internal:3128
